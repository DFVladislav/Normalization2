2026-11-17T07:08:38.874415Z	   62 Query	USE sales_norm_lab2
2026-11-17T07:08:38.874735Z	   62 Query	CREATE TABLE clients (
    client_id   INT          NOT NULL,
    client_name VARCHAR(100) NOT NULL,
    client_city VARCHAR(100) NOT NULL,
    PRIMARY KEY (client_id)
)
2026-11-17T07:08:38.960009Z	   62 Query	CREATE TABLE products (
    product_id   INT           NOT NULL,
    product_name VARCHAR(100)  NOT NULL,
    unit_price   DECIMAL(10,2) NOT NULL,
    PRIMARY KEY (product_id)
)
2026-11-17T07:08:39.020422Z	   62 Query	CREATE TABLE sales (
    sale_id   INT  NOT NULL,
    sale_date DATE NOT NULL,
    client_id INT  NOT NULL,
    PRIMARY KEY (sale_id),
    FOREIGN KEY (client_id) REFERENCES clients (client_id)
)
2026-11-17T07:08:39.121116Z	   62 Query	CREATE TABLE sale_items (
    sale_id    INT NOT NULL,
    product_id INT NOT NULL,
    quantity   INT NOT NULL,
    PRIMARY KEY (sale_id, product_id),
    FOREIGN KEY (sale_id) REFERENCES sales (sale_id),
    FOREIGN KEY (product_id) REFERENCES products (product_id)
)
